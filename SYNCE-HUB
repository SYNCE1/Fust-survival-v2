local activeSlider
-- A nil value is shown as UNSET (the bar stays empty until the user moves it).
local function slider(parent, text, tbl, key, min, max, decimals)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, 38)
	f.BackgroundColor3 = PANEL
	f.BorderSizePixel = 0
	f.Parent = parent
	stroke(f, EDGE, 1)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -10, 0, 18)
	lbl.Position = UDim2.fromOffset(8, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = FONT
	lbl.TextSize = 14
	lbl.TextColor3 = TEXT
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = f
	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 8, 0, 25)
	bar.Size = UDim2.new(1, -16, 0, 6)
	bar.BackgroundColor3 = BG
	bar.BorderSizePixel = 0
	bar.Parent = f
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = RUST
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local mult = 10 ^ (decimals or 0)
	local function set(v)
		v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		tbl[key] = v
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(v)
	end
	local function refresh()
		if tbl[key] == nil then
			fill.Size = UDim2.new(0, 0, 1, 0)
			lbl.Text = text .. ": UNSET"
		else
			set(tbl[key])
		end
	end
	refresh()
	local function fromInput(x)
		set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1))
	end
	f.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = fromInput
			fromInput(i.Position.X)
		end
	end)
	return refresh
end

table.insert(connections, UIS.InputChanged:Connect(function(i)
	if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		activeSlider(i.Position.X)
	end
end))
table.insert(connections, UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		activeSlider = nil
	end
end))

